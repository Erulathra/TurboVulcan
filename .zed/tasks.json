[
   {
      "label": "Refresh CMake project [Debug Development]",
      "command": "cmake",
      "cwd": "$ZED_WORKTREE_ROOT",

      "args": [
         "-S", "\"$ZED_WORKTREE_ROOT\"",
         "--preset", "cmake-build-debug-development",
      ],

      "env": {
         "CC": "clang",
         "CXX": "clang++",
      },

      "reveal": "always",
      "hide": "never",
   },

   {
      "label": "Build [Debug Developement]",
      "command": "cmake",
      "cwd": "$ZED_WORKTREE_ROOT",
      "args": [
         "--build",
         "cmake-build-debug-development",
         "--parallel",
      ],

      "allow_concurrent_runs": false,
      "hide": "never",
      "reveal": "no_focus"
   },

   {
      "label": "Refresh CMake project [Release Shipping]",
      "command": "cmake",
      "cwd": "$ZED_WORKTREE_ROOT",

      "args": [
         "-S", "\"$ZED_WORKTREE_ROOT\"",
         "--preset", "cmake-build-release-shipping",
      ],

      "env": {
         "CC": "clang",
         "CXX": "clang++",
      },

      "allow_concurrent_runs": false,
      "hide": "never",
   },

   {
      "label": "Build [Release Shipping]",
      "cwd": "$ZED_WORKTREE_ROOT",
      "command": "cmake",
      "args": [
         "--build",
         "cmake-build-release-shipping",
         "--parallel",
      ],

      "allow_concurrent_runs": false,
      "hide": "never",
   },
]
